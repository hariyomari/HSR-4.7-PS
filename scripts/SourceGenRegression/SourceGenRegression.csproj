<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- The case inputs and expectations are data for the generators, not part of this program. -->
    <Compile Remove="Cases/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Google.Protobuf and MemoryPack are referenced so the generated samples can be compiled against them. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="MemoryPack" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../../SourceGen/SourceGen.csproj" />
  </ItemGroup>
</Project>
