<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../WebServer/WebServer.csproj" />
    <ProjectReference Include="../../Command/Command.csproj" />
    <ProjectReference Include="../../Proto/Tool/ProtoOrganizer/ProtoOrganizer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      4.8-only activities from upstream (ActivityBangboo, RealityShow): GameServer.csproj excludes them while the 4.7
      protocol is active, so their regressions are not built either. Their call sites in Program.cs and the inline
      DiceyDungeon cases sit behind PROTOCOL_48_ACTIVITIES.
    -->
    <Compile Remove="ActivityBangbooRegression.cs" />
    <Compile Remove="RealityShowRegression.cs" />
  </ItemGroup>
</Project>
