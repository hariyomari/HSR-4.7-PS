<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>March7thHoney.GameServer</RootNamespace>
    <StartupObject></StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>March7thHoney.GameServer</AssemblyName>
    <ApplicationIcon>March7thHoney.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
	  <Content Include="March7thHoney.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- PlayerInstance is referenced pervasively (handlers, managers, packets); import it globally to cut per-file using churn. -->
    <Using Include="March7thHoney.GameServer.Game.Player" />
  </ItemGroup>

  <ItemGroup>
    <!-- 4.6 leaves only two same-typed uint32 candidates; the old mapping was an unverified guess, so it is not guessed again. -->
    <Compile Remove="Server/Packet/Recv/DiceCombat/HandlerDiceCombatFinishPveStageCsReq.cs" />
    <!--
      4.8-only activities from upstream (ActivityBangboo, DiceyDungeon). Their commands and messages are missing from
      the active 4.7 protocol (Proto/4.7, KcpSharp/CmdIds.cs), and the mapping is not guessed. Their player components
      are not wired in PlayerInstance.WireManagers while these are excluded.
    -->
    <Compile Remove="Game/Activity/ActivityBangboo/**" />
    <Compile Remove="Game/Activity/DiceyDungeon/**" />
    <Compile Remove="Game/Mission/FinishType/Handler/MissionHandlerActivityBangboo.cs" />
    <Compile Remove="Game/Mission/FinishType/Handler/MissionHandlerDiceyDungeonFinish.cs" />
    <Compile Remove="Server/Packet/Recv/ActivityBangboo/**" />
    <Compile Remove="Server/Packet/Send/ActivityBangboo/**" />
    <Compile Remove="Server/Packet/Recv/DiceyDungeon/**" />
    <Compile Remove="Server/Packet/Send/DiceyDungeon/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\KcpSharp\KcpSharp.csproj" />
    <ProjectReference Include="..\Proto\Proto.csproj" />
    <ProjectReference Include="..\SourceGen\SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

</Project>
