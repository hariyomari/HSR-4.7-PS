<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>March7thHoney.Program</RootNamespace>
    <AssemblyName>March7thHoney</AssemblyName>
    <ApplicationIcon>March7thHoney.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    NativeAOT publish: pass `-p:DoAot=true` to `dotnet publish`. A custom gate
    property (rather than passing PublishAot globally) keeps PublishAot local to this
    executable, so it never leaks onto the SourceGen analyzer (netstandard2.0, NETSDK1207).
  -->
  <PropertyGroup Condition="'$(DoAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <!-- First goal is a runnable native binary; don't fail on trim/AOT warnings yet. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Keep reflection-heavy libraries whole so trimming doesn't break them at runtime. -->
  <ItemGroup Condition="'$(DoAot)' == 'true'">
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="System.Management" />
    <TrimmerRootAssembly Include="MailKit" />
    <TrimmerRootAssembly Include="MimeKit.Core" />
    <TrimmerRootAssembly Include="BouncyCastle.Cryptography" />
    <TrimmerRootAssembly Include="Spectre.Console" />
    <!-- Custom JSON configs (Banners, ActivityConfig, VideoKeys, room gen...) are read via Newtonsoft reflection. -->
    <TrimmerRootAssembly Include="March7thHoney.Common" />
  </ItemGroup>

  <!-- The in-process IIS shim is dead weight for a self-hosted Kestrel server; drop it from publish. -->
  <Target Name="RemoveUnusedInProcessShim" AfterTargets="Publish">
    <Delete Files="$(PublishDir)aspnetcorev2_inprocess.dll" />
  </Target>

  <ItemGroup>
	  <Content Include="March7thHoney.ico" />
  </ItemGroup>

  <!--
    A publish carries the configuration defaults tracked in Config/: the server reads Config/ relative to its
    working directory, and without Config/Security/LoginRsaPrivateKey.pem it rejects every encrypted login.
    The key pair is the one the CyreneLauncher proxy and its hook DLL encrypt with by default; a public server
    replaces it. Runtime data (Config.json, Database/, Logs/) and the untracked resource cache are not copied.
  -->
  <ItemGroup>
    <ServerConfigDefault Include="..\Config\ClientSecretKey.ec2b;..\Config\RogueMagicRoomGen.json" TargetFolder="Config" />
    <ServerConfigDefault Include="..\Config\Custom\*.json" TargetFolder="Config\Custom" />
    <ServerConfigDefault Include="..\Config\Json\*.json" TargetFolder="Config\Json" />
    <ServerConfigDefault Include="..\Config\Languages\*.json" TargetFolder="Config\Languages" />
    <ServerConfigDefault Include="..\Config\Security\*.pem" TargetFolder="Config\Security" />
    <None Include="@(ServerConfigDefault)"
          Link="%(TargetFolder)\%(Filename)%(Extension)"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildUtc" Value="$([System.DateTime]::UtcNow.ToString(&quot;yyyy-MM-ddTHH:mm:ssZ&quot;))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Command\Command.csproj" />
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\GameServer\GameServer.csproj" />
    <ProjectReference Include="..\WebServer\WebServer.csproj" />
  </ItemGroup>

</Project>

